# Copy this file to .env.
#
# Hosted backend (recommended for Expo Go away from your Wi-Fi):
#   EXPO_PUBLIC_API_BASE_URL=https://your-service.onrender.com
#
# Same-Wi-Fi development:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:3000
#   Find your IPv4 address with `ipconfig` (Windows), `ipconfig getifaddr en0`
#   (macOS) or `hostname -I` (Linux).
#
# If the backend sets API_ACCESS_TOKEN, set the same value here. This is
# bundled into the app, so treat it as an abuse gate, not a secret.
#
# After changing this file, restart Expo (and press "r" to reload the app).

EXPO_PUBLIC_API_BASE_URL=https://your-service.onrender.com
EXPO_PUBLIC_API_ACCESS_TOKEN=
