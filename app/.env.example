# Copy this file to .env and set it to your computer's LAN IP (not
# localhost/127.0.0.1) so the app can reach the backend from a physical
# device or Expo Go. Include the backend port.
#
# Example:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:3000
#
# Find your IP:
#   Windows: ipconfig          (look for "IPv4 Address" on your active adapter)
#   macOS:   ipconfig getifaddr en0
#   Linux:   hostname -I
#
# After changing this file, restart Expo (and press "r" to reload the app).

EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:3000
