# Copy this file to .env and fill in your own values.
# Everything here is optional. The Cloudflare credentials are only needed for
# the AI-assisted text, photo, video and sound features; the checklist and
# library work without them.

# Port the API server listens on. 0 lets the OS choose (used by tests).
PORT=3000

# Where the SQLite database file is created. Relative paths are resolved from
# the backend/ folder, not from your shell's current directory. The file and
# its journal/WAL files are gitignored.
DB_PATH=./torquedoc.db

# --- AI: Cloudflare Workers AI (recommended free option) -----------------
# Create a free Cloudflare account, open Workers AI, and copy the Account ID.
# Create an API token with Workers AI access. Both values are server-side only
# and are never sent to the mobile app. Free plan: 10,000 Neurons/day, no card;
# Cloudflare documents zero retention and no training on submitted content.
CLOUDFLARE_ACCOUNT_ID=

CLOUDFLARE_API_TOKEN=

# Mistral Small 3.1 handles both text and vision (including multiple video
# frames). Some accounts may prefer the cheaper Llama 3.2 Vision model:
# CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
CLOUDFLARE_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct

# Audio sound-pattern analysis. clef-omni is free-tier eligible, uses about
# 780 tokens per audio minute, and documents zero data retention.
CLOUDFLARE_AUDIO_MODEL=@cf/cloudflare/clef-omni

# Optional per-request timeout for Cloudflare/Anthropic calls, in milliseconds.
AI_TIMEOUT_MS=60000

# --- Optional legacy provider (paid; leave blank for a free deployment) ---
# Anthropic is still supported by the code if you already have credits, but this
# project is designed for the Cloudflare Workers Free plan. Do not set a paid
# provider key for a no-cost deployment. Cloudflare is preferred when both are
# configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Maximum accepted photo/video/audio upload size, in megabytes. Audio is
# transcoded and trimmed to 30 seconds before it reaches the model.
MAX_UPLOAD_MB=30

# CORS allow-list. "*" is convenient for local development; set a
# comma-separated list of origins if you expose the API beyond your machine.
CORS_ORIGIN=*

# Set to false to silence the one-line-per-request HTTP log.
LOG_REQUESTS=true

# --- Public deployment ---------------------------------------------------
# Shared abuse-gate key. Garage, catalog, diagnosis and AI routes additionally
# require a signed-in account session, but login/register still require this
# key so the public URL is not an open registration proxy. Generate a random
# value (32+ characters), set the same value as
# EXPO_PUBLIC_API_ACCESS_TOKEN in app/.env, and never commit either file.
API_ACCESS_TOKEN=

# Set true when the app runs behind Render/Railway/another reverse proxy so
# rate limiting sees the real client IP.
TRUST_PROXY=false

# Requests per minute per IP. The AI limit is deliberately tighter, and
# register/login have their own small bucket.
RATE_LIMIT_PER_MINUTE=240
AI_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_PER_MINUTE=12
